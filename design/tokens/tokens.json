{
  "$description": "Alpha Color Lab design tokens, W3C DTCG style. Nguồn duy nhất. Build: node design/tokens/build.mjs. Màu: $value là chuỗi (chỉ sáng) hoặc {light, dark}. Chuỗi dạng \"{color.x}\" là tham chiếu.",
  "color": {
    "bg": {
      "$type": "color",
      "$value": { "light": "#f2f2f7", "dark": "#000000" }
    },
    "card": {
      "$type": "color",
      "$value": { "light": "#ffffff", "dark": "#1c1c1e" }
    },
    "card-elevated": {
      "$type": "color",
      "$value": { "light": "#ffffff", "dark": "#2c2c2e" },
      "$description": "Sheet, popover."
    },
    "label": {
      "$type": "color",
      "$value": { "light": "#0b0d12", "dark": "#f5f5f7" }
    },
    "secondary": {
      "$type": "color",
      "$value": { "light": "#4a5260", "dark": "#a1a1a6" },
      "$description": "Chữ phụ."
    },
    "tertiary": {
      "$type": "color",
      "$value": { "light": "#7c8594", "dark": "#636366" },
      "$description": "Chỉ trang trí, không dùng cho chữ."
    },
    "separator": {
      "$type": "color",
      "$value": { "light": "#e3e6eb", "dark": "#38383a" }
    },
    "fill": {
      "$type": "color",
      "$value": { "light": "rgb(11 13 18 / 0.05)", "dark": "rgb(255 255 255 / 0.08)" },
      "$description": "Chip, rãnh segmented. Bán trong suốt."
    },
    "fill-strong": {
      "$type": "color",
      "$value": { "light": "rgb(11 13 18 / 0.09)", "dark": "rgb(255 255 255 / 0.14)" },
      "$description": "Hover trên fill. Bán trong suốt."
    },
    "accent": {
      "$type": "color",
      "$value": { "light": "#c2410c", "dark": "#c2410c" },
      "$description": "Một màu nhấn. Light: nền nút chính, chọn, focus. Dark: chỉ nền nút chính (chữ trắng); viền chọn, focus và icon nhấn dùng accent-text."
    },
    "on-accent": {
      "$type": "color",
      "$value": { "light": "#ffffff", "dark": "#ffffff" },
      "$description": "Chữ và icon trên nền accent."
    },
    "accent-text": {
      "$type": "color",
      "$value": { "light": "#c2410c", "dark": "#ff8a3d" },
      "$description": "Chữ và link màu nhấn."
    },
    "app-console": {
      "$type": "color",
      "$value": "{color.accent}",
      "$description": "Bằng accent."
    },
    "app-colors": {
      "$type": "color",
      "$value": { "light": "#0789b0", "dark": "#3ab8e0" },
      "$description": "Màu nhận diện app. Chỉ trang trí, ≥3:1 trên nền."
    },
    "app-wiki": {
      "$type": "color",
      "$value": { "light": "#0b9468", "dark": "#34c08a" },
      "$description": "Màu nhận diện app. Chỉ trang trí, ≥3:1 trên nền."
    },
    "app-blog": {
      "$type": "color",
      "$value": { "light": "#5a55d6", "dark": "#8e8aff" },
      "$description": "Màu nhận diện app. Chỉ trang trí, ≥3:1 trên nền."
    },
    "success": {
      "$type": "color",
      "$value": { "light": "#127a3a", "dark": "#30d158" }
    },
    "success-fill": {
      "$type": "color",
      "$value": { "light": "rgb(18 160 70 / 0.1)", "dark": "rgb(48 209 88 / 0.16)" },
      "$description": "Nền badge. Bán trong suốt."
    },
    "warning": {
      "$type": "color",
      "$value": { "light": "#a84e00", "dark": "#ffb340" }
    },
    "warning-fill": {
      "$type": "color",
      "$value": { "light": "rgb(240 140 20 / 0.12)", "dark": "rgb(255 179 64 / 0.16)" },
      "$description": "Nền badge. Bán trong suốt."
    },
    "danger": {
      "$type": "color",
      "$value": { "light": "#c8261b", "dark": "#ff6961" }
    },
    "danger-fill": {
      "$type": "color",
      "$value": { "light": "rgb(220 40 30 / 0.08)", "dark": "rgb(255 105 97 / 0.16)" },
      "$description": "Nền badge. Bán trong suốt."
    },
    "google-blue": {
      "$type": "color",
      "$value": "#4285f4",
      "$extensions": { "alphacolorlab": { "scope": "web" } },
      "$description": "Thương hiệu Google, chỉ web, chỉ sáng."
    },
    "google-red": {
      "$type": "color",
      "$value": "#ea4335",
      "$extensions": { "alphacolorlab": { "scope": "web" } },
      "$description": "Thương hiệu Google, chỉ web, chỉ sáng."
    },
    "google-yellow": {
      "$type": "color",
      "$value": "#fbbc05",
      "$extensions": { "alphacolorlab": { "scope": "web" } },
      "$description": "Thương hiệu Google, chỉ web, chỉ sáng."
    },
    "google-green": {
      "$type": "color",
      "$value": "#34a853",
      "$extensions": { "alphacolorlab": { "scope": "web" } },
      "$description": "Thương hiệu Google, chỉ web, chỉ sáng."
    }
  },
  "text": {
    "footnote": {
      "$type": "typography",
      "$value": { "fontSize": "13px", "lineHeight": "19px" }
    },
    "subhead": {
      "$type": "typography",
      "$value": { "fontSize": "15px", "lineHeight": "22px" }
    },
    "callout": {
      "$type": "typography",
      "$value": { "fontSize": "16px", "lineHeight": "24px" },
      "$description": "Tối thiểu cho input/select: dưới 16px iOS Safari tự zoom."
    },
    "body": {
      "$type": "typography",
      "$value": { "fontSize": "17px", "lineHeight": "27px" }
    },
    "title3": {
      "$type": "typography",
      "$value": { "fontSize": "20px", "lineHeight": "28px" }
    },
    "title2": {
      "$type": "typography",
      "$value": { "fontSize": "24px", "lineHeight": "32px", "letterSpacing": "-0.01em" },
      "$description": "Đề mục trong bài viết."
    },
    "title": {
      "$type": "typography",
      "$value": { "fontSize": "clamp(28px, 4vw, 40px)", "lineHeight": "1.12", "letterSpacing": "-0.03em" }
    },
    "display": {
      "$type": "typography",
      "$value": { "fontSize": "clamp(40px, 7vw, 76px)", "lineHeight": "1.02", "letterSpacing": "-0.045em" }
    }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "24px" },
    "control": { "$type": "dimension", "$value": "14px" },
    "badge": { "$type": "dimension", "$value": "8px" }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": "0 0 0 1px rgb(11 13 18 / 0.06), 0 1px 2px rgb(11 13 18 / 0.04)"
    },
    "thumb": {
      "$type": "shadow",
      "$value": "0 0 0 1px rgb(11 13 18 / 0.08), 0 2px 6px rgb(11 13 18 / 0.12)"
    }
  },
  "ease": {
    "ios": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Noto Sans", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"],
      "$description": "Web và Android: Noto Sans. iOS: font hệ thống (SF Pro)."
    }
  }
}
